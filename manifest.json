{
  "manifest_version": 3,
  "name": "Input Healer & Wispr Flow AI Studio Auto-Paster",
  "version": "1.0.0",
  "description": "Unfreezes stuck input fields and ensures seamless Wispr Flow dictation into Google AI Studio and other web apps.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardRead"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/content/utils.js",
        "src/content/detector.js",
        "src/content/universal_healer.js",
        "src/content/aistudio_adapter.js",
        "src/content/main.js"
      ],
      "css": ["src/content/styles.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/injected/page_engine.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Input Healer Settings"
  },
  "commands": {
    "unfreeze_field": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Unfreeze & focus current input field"
    },
    "quick_paste_wispr": {
      "suggested_key": {
        "default": "Ctrl+Shift+V",
        "mac": "Command+Shift+V"
      },
      "description": "Smart Paste from Clipboard (Wispr Flow Catch)"
    }
  }
}
